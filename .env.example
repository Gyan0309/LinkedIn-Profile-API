# Variable names only -- never commit real values.
#
# Note what is absent: no LinkedIn cookie, no API key. Callers send their own
# session per request, so there is nothing here to leak. Everything below is
# operational tuning, and the service runs fine without this file.

# How hard one caller may lean on the service.
RATE_LIMIT_PER_HOUR=60

# How hard the whole process may lean on LinkedIn. The one that matters: every
# caller shares one outbound IP, and LinkedIn blocks an IP as a unit.
OUTBOUND_MAX_PER_MINUTE=30

# Cached per session, so two callers never share an entry.
CACHE_TTL_SECONDS=21600

# Optional, for when the host IP gets flagged (HTTP 999). Residential proxies
# only -- datacenter ones are blocked on sight.
OUTBOUND_PROXY_URL=

# Optional. Pins GraphQL query hashes. The profile path is dash REST end to
# end and needs none; this only matters if the dash identity lookup starts
# failing. Get the values with: python scripts/pin_queryids.py
LINKEDIN_QUERY_IDS_JSON=

LOG_LEVEL=INFO

# auto | always | never. `auto` colours a terminal, leaves a log file clean.
LOG_COLOUR=auto
