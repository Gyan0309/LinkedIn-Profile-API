# ---------------------------------------------------------------------------
# Variable NAMES only. Never commit real values — this file is the contract,
# .env is the secret and is gitignored.
# ---------------------------------------------------------------------------

# --- LinkedIn session (pick ONE path) --------------------------------------
# Path A (recommended): cookies lifted from a browser already logged in.
# Log in from a normal residential connection first, then copy the cookies here.
# See README "Getting a session" for why this ordering matters.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Path B (convenience): programmatic login. Trips a challenge more often,
# especially from a datacenter IP. Falls back to a clear error, never a CAPTCHA solve.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- This API's own auth ---------------------------------------------------
# Comma-separated. Callers presenting one of these in X-API-Key may query any
# profile URL. Leave empty to run the service in demo-only mode.
API_KEYS=

# Comma-separated public identifiers callers may query WITHOUT a key.
DEMO_PROFILES=williamhgates,satyanadella,jeffweiner08

# --- Operational -----------------------------------------------------------
# Optional. Route LinkedIn traffic through a proxy when the host IP gets flagged
# (HTTP 999). Residential proxies only — datacenter proxies are blocked on sight.
OUTBOUND_PROXY_URL=

# Pin GraphQL queryIds instead of discovering them at runtime. JSON object.
# Use when discovery breaks and you have a known-good set.
LINKEDIN_QUERY_IDS_JSON=

CACHE_TTL_SECONDS=21600
DEMO_RATE_LIMIT_PER_HOUR=20
KEYED_RATE_LIMIT_PER_HOUR=300
OUTBOUND_MAX_PER_MINUTE=30
LOG_LEVEL=INFO
